  <!-- 346.3 gal us = 2078 lb -->
  <tank x="2.33" y=" 2.3" z="-0.921" capacity="3500"/>
  <!-- 346.3 gal us = 2078 lb -->
  <tank x="2.33" y="-2.3" z="-0.921" capacity="3500"/>

  <!-- Mass distribution
       Dilbert : The cg should be about 1/6 chord ahead of the chord center.
       2.304 / 6     = 0.384
       1.899 + 0.384 = 2.283
  -->
  <ballast x="6.6" y="0" z="-0.8" mass="1200"/>

