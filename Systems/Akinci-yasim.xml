  <wing x="1.899" y="0" z="-1.047"
        chord    = "2.304"
        length   = "2.778"
        taper    = "1"
        dihedral = "4"
        camber   = "0.05">
        <stall   aoa="86" width="1" peak="1.5"/>
        <flap0 start="0.34" end="1" lift="1.34" drag="1.9"/>

        <control-input  control="FLAP0" axis="/controls/flight/flaps"/>

        <control-output control="FLAP0" prop="/surface-positions/flap-pos-norm"/>

        <control-speed  control="FLAP0" transition-time="5"/>
  </wing>

    <wing x="2.019" y="2.778" z="-0.853"
        append   = "1"
        chord    = "2.544"
        length   = "1.142"
        taper    = "0.80"
        dihedral = "3.6"
        sweep    = "8">
        <stall   aoa="28" width="1" peak="1.5"/>
        <flap0 start="0"    end="1" lift="1.34" drag="1.9"/>

        <control-input  control="FLAP0" axis="/controls/flight/flaps"/>

        <control-output control="FLAP0" prop="/surface-positions/flap-pos-norm"/>

        <control-speed control="FLAP0" transition-time="4"/>
  </wing>

  <wing x="1.846" y="3.915" z="-0.787"
        append   = "1"
        chord    = "2.000"
        length   = "4.856"
        taper    = "0.46"
        dihedral = "5"
        sweep    = "-2.5">
        <stall   aoa="28" width="1"    peak="1.5"/>
        <flap0 start="0.00" end="0.51" lift="1.34" drag="1.9"/>
        <flap1 start="0.51" end="1.00" lift="1.30" drag="1.2"/>

        <control-input  control="FLAP0" axis="/controls/flight/flaps"/>
        <control-input  control="FLAP1" axis="/controls/flight/aileron"      split="true"/>
        <control-input  control="FLAP1" axis="/controls/flight/aileron-trim" split="true"/>

        <control-output control="FLAP0" prop="/surface-positions/flap-pos-norm"/>
        <control-output control="FLAP1" prop="/surface-positions/left-aileron-pos-norm"  side="left"/>
        <control-output control="FLAP1" prop="/surface-positions/right-aileron-pos-norm" side="right"/>

        <control-speed control="FLAP0" transition-time="4"/>
  </wing>

  <hstab x="-5.786" y="0" z="2.091"
         chord  = "1.580"
         length = "2.826"
         taper  = "0.5"
         sweep  = "12">
         <stall   aoa="26" width="1" peak="1.5"/>
         <flap0 start="0"    end="1" lift="1.3" drag="1.2"/>

         <control-input  control="FLAP0" axis="/controls/flight/elevator"/>
         <control-input  control="FLAP0" axis="/controls/flight/elevator-trim"/>

         <control-output control="FLAP0" prop="/surface-positions/elevator-pos-norm"/>
  </hstab>

  <vstab x="-4.231" y="0" z="-0.184"
         chord  = "2.711"
         length = "2.6"
         taper  = "0.60"
         sweep  = "35">
         <stall   aoa="22" width="1" peak="1.5"/>
         <flap0 start="0"    end="1" lift="1.3" drag="1.2"/>

         <control-input  control="FLAP0" axis="/controls/flight/rudder" invert="true"/>
         <control-input  control="FLAP0" axis="/controls/flight/rudder-trim" invert="true"/>

         <control-output control="FLAP0" prop="/surface-positions/rudder-pos-norm"/>
  </vstab>

  <!-- ENGINES -->

  <propeller x=" 4.217" y=" 2.774" z="-0.741"
             mass         = "487"
             moment       = "25.0"
             radius       = "1.30"
             cruise-speed = "300"
             cruise-rpm   = "1900"
             cruise-power = "800"
             cruise-alt   = "30000"
             min-rpm      = "220"
             max-rpm      = "2700">
             <actionpt x=" 5.517" y=" 2.774" z="-0.641"/>
             <control-input control="ADVANCE" axis="/controls/engines/engine[0]/propeller-pitch"/>
             <turbine-engine eng-power   = "1050"
                             eng-rpm     = "2700"
                             alt         = "40000"
                             flat-rating = "750"
                             min-n2      = "60"
                             max-n2      = "100"
                             bsfc         = "0.35">
