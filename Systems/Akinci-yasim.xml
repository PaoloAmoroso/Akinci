                             <control-input control="MAGNETOS" axis="/controls/engines/engine[1]/magnetos"/>
                             <control-input control="BOOST"    axis="/controls/engines/engine[1]/boost"/>
             </turbine-engine>
  </propeller>

  <!-- trusters for reverse -->
  <thruster x=" 5.517" y=" 2.774" z="-0.641"
            vx="-1" vy="0" vz="0"
            thrust="1050">
            <control-input control="THROTTLE" axis="/controls/engines/engine[0]/reverser" src0="0" src1="1" dst0="0" dst1="1"/>
  </thruster>

  <thruster x=" 5.517" y="-2.774" z="-0.641"
            vx="-1" vy="0" vz="0"
            thrust="1050">
            <control-input control="THROTTLE" axis="/controls/engines/engine[1]/reverser" src0="0" src1="1" dst0="0" dst1="1"/>
  </thruster>

  <!-- Roue du nez -->
  <gear x=" 6.694" y=" 0.0000" z="-1.8063"
        compression = "0.15"
        spring      = "0.6"
        stiction    = "1">
        <control-input  control="STEER"  axis="/controls/flight/rudder" square="true" src0="-1.0" src1="1.0" dst0="-0.8" dst1="0.8"/>
