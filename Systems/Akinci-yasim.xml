  <fuselage ax=" 3.986" ay="-0.165" az=" 0.136" bx="-1.670" by="-0.165" bz=" 0.136" width="0.848" taper="1.00" midpoint="1"/>
  <fuselage ax="-1.670" ay="-0.145" az=" 0.136" bx="-5.592" by="-0.000" bz="-0.158" width="0.937" taper="0.30" midpoint="0"/>

  <!-- Left engine -->
  <fuselage ax=" 5.887" ay=" 2.774" az="-0.641" bx=" 5.705" by=" 2.774" bz="-0.641" width="0.305" taper="0.10" midpoint="1"/>
  <fuselage ax=" 5.705" ay=" 2.774" az="-0.641" bx=" 5.508" by=" 2.774" bz="-0.641" width="0.484" taper="0.63" midpoint="1"/>
  <fuselage ax=" 5.508" ay=" 2.774" az="-0.641" bx=" 5.250" by=" 2.774" bz="-0.641" width="0.685" taper="0.71" midpoint="1"/>
