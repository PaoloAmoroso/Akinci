<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <sim               include="views.xml">

    <fuel-fraction>1</fuel-fraction>

    <startup>
      <splash-texture>Aircraft/Akinci/Akinci-splash.png</splash-texture>
    </startup>

    <sound>
      <path>Aircraft/Akinci/Sounds/Akinci-sound.xml</path>
    </sound>

    <model>
      <path>Aircraft/Akinci/Models/Akinci.xml</path>
      <livery>
        <file        type="string"/>
        <specular>
          <red       type="float"> 0.03 </red>
          <green     type="float"> 0.03 </green>
          <blue      type="float"> 0.03 </blue>
        </specular>
      </livery>
    </model>

    <submodels>
      <serviceable   type="bool">true</serviceable>
      <path>Aircraft/Akinci/Models/Effects/Submodels.xml</path>
    </submodels>

    <multiplay>
      <chat_display>1</chat_display>

      <generic>

        <!-- INT -->
        <int    n="0"  type="int"/>
        <int    n="1"  type="int"/>
        <int    n="2"  type="int"/>
        <int    n="3"  type="int"/>
        <int    n="4"  type="int"/>
        <int    n="5"  type="int"/>
        <!-- -->
        <int    n="6"  alias="/sim/model/radarmode"/>

        <!-- BOOL -->
        <!-- Configuration -->
        <bool   n="0"  alias="/sim/model/show-REDET"/>
        <bool   n="1"  alias="/sim/model/show-HEDET"/>

        <!-- HDR -->
        <bool   n="2"  alias="/sim/rendering/hdr/hdr-enabled"/>

        <!-- Landing Gear -->
        <bool   n="3"  alias="/gear/gear[0]/wow"/>
        <bool   n="4"  alias="/gear/gear[1]/wow"/>
        <bool   n="5"  alias="/gear/gear[2]/wow"/>

        <!-- Engines -->
        <bool   n="6"  alias="/controls/engines/engine[0]/cutoff"/>
        <bool   n="7"  alias="/controls/engines/engine[1]/cutoff"/>
        <bool   n="9"  alias="/engines/engine[0]/running"/>
        <bool   n="10" alias="/engines/engine[1]/running"/>

        <!-- Lights -->
        <bool   n="11" alias="/controls/lighting/beacon"/>
        <bool   n="12" alias="/sim/model/lights/beacon/state"/>
        <bool   n="13" alias="/controls/lighting/strobe"/>
        <bool   n="14" alias="/sim/model/lights/sbc1/state"/>
        <bool   n="15" alias="/controls/lighting/nav-lights"/>
        <bool   n="16" alias="/controls/lighting/landing-lights"/>

        <!-- Starter -->
        <bool   n="17" alias="/controls/engines/engine[0]/starter"/>
        <bool   n="18" alias="/controls/engines/engine[1]/starter"/>

        <!-- Pylons -->
        <bool   n="20"  alias="/sim/model/show-C1"/>
        <bool   n="21"  alias="/sim/model/show-W1"/>
        <bool   n="22" alias="/sim/model/show-W2-1"/>
        <bool   n="23" alias="/sim/model/show-W2-2"/>
        <bool   n="24" alias="/sim/model/show-W2-3"/>

        <!-- Payload and Weapons -->
        <bool   n="25" alias="/sim/model/show-Antidot"/>
        <bool   n="26" alias="/sim/model/show-SOM-J-1"/>
        <bool   n="27" alias="/sim/model/show-SOM-J"/>
        <bool   n="28" alias="/sim/model/show-GBU-12-1"/>
        <bool   n="29" alias="/sim/model/show-GBU-12"/>
        <bool   n="30" alias="/sim/model/show-GBU-54"/>

        <!-- FLOATS -->
        <!-- Doors -->
        <float  n="0"  alias="/sim/model/door-positions/crew/position-norm"/>
        <float  n="1"  alias="/sim/model/door-positions/flir/position-norm"/>

        <!-- Position -->
        <float  n="2"  alias="/position/gear-agl-m">0</float>
        <float  n="3"  alias="/position/altitude-ft">0</float>

        <!-- Engines -->
        <float  n="4"  alias="/engines/engine[0]/n1"/>
        <float  n="5"  alias="/engines/engine[1]/n1"/>
        <float  n="10" alias="/engines/engine[0]/prop-thrust"/>
        <float  n="11" alias="/engines/engine[1]/prop-thrust"/>

        <!-- Landing Gear -->
        <float  n="12" alias="/gear/gear[0]/rollspeed-ms"/>
        <float  n="13" alias="/gear/gear[1]/rollspeed-ms"/>
        <float  n="14" alias="/gear/gear[2]/rollspeed-ms"/>
        <float  n="15" alias="/gear/gear[0]/caster-angle-deg"/>
        <!-- Airspeed -->
        <float  n="16" alias="/instrumentation/airspeed-indicator/indicated-speed-kt"/>

        <!-- Propeller -->
        <float  n="17" alias="/controls/engines/engine[0]/propeller-pitch"/>
        <float  n="18" alias="/controls/engines/engine[1]/propeller-pitch"/>

        <!-- Compression -->
        <float  n="23" alias="/gear/gear[0]/compression-norm"/>
        <float  n="24" alias="/gear/gear[1]/compression-norm"/>
        <float  n="25" alias="/gear/gear[2]/compression-norm"/>

        <!-- FLIR Turret -->
        <float  n="26" alias="/sim/model/turret[0]/heading"/>
        <float  n="27" alias="/sim/model/turret[0]/pitch"/>

        <!-- Livery -->
        <string n="1"  alias="/sim/model/livery/texture"/>

        <!-- For Bombable -->
        <string n="9"  type="string"/>
        <int    n="10" alias="/controls/armament/trigger"/>
        <int    n="11" alias="/controls/armament/trigger2"/>

        <!-- SOM-J -->
        <int    n="12" alias="/controls/armament/signal1"/>
        <int    n="13" alias="/controls/armament/signal2"/>
        <int    n="14" alias="/controls/armament/signal3"/>
        <!-- GBU-12 -->
        <int    n="15" alias="/controls/armament/signal4"/>
        <int    n="16" alias="/controls/armament/signal5"/>
        <int    n="17" alias="/controls/armament/signal6"/>
        <!-- GBU-54 -->
        <int    n="18" alias="/controls/armament/signal7"/>
        <int    n="19" alias="/controls/armament/signal8"/>
        <int    n="20" alias="/controls/armament/signal9"/>
        <int    n="21" alias="/controls/armament/signal10"/>

      </generic>

    </multiplay>

    <menubar         include="../Dialogs/Akinci-menu.xml"/>

    <help>

  <title>Baykar Bayraktar Akinci</title>
  <line>______________________________________________</line>
  <key>
    <name>}</name>
    <desc>AutoStart/AutoStop</desc>
  </key>
  <key>
    <name>r</name>
    <desc>FLIR On/Off</desc>
  </key>
  <key>
    <name>M</name>
    <desc>Pylon 1 2 3 | 7 8 9 Release</desc>
  </key>
  <key>
    <name>m</name>
    <desc>Pylon 4 | 6 Release</desc>
  </key>
  <key>
    <name>n</name>
    <desc>Pylon 5 Release</desc>
  </key>
  <key>
    <name>l</name>
    <desc>Landing lights on/off</desc>
  </key>
  <key>
    <name>h</name>
    <desc>HUD</desc>
  </key>
  <key>
    <name>shift+i (I)</name>
    <desc>HUD Mode</desc>
  </key>
  <key>
    <name>shift+q (Q)</name>
    <desc>Reset view</desc>
  </key>

    </help>

    <flaps>
        <setting> 0.00 </setting> <!--  0 deg -->
        <setting> 0.25 </setting> <!-- 10 deg -->
        <setting> 0.50 </setting> <!-- 20 deg -->
        <setting> 0.75 </setting> <!-- 30 deg -->
        <setting> 1.00 </setting> <!-- 35 deg -->
    </flaps>

    <aircraft-data>
        <path>/sim/multiplay/generic/bool[0]</path>
        <path>/sim/multiplay/generic/bool[1]</path>
        <path>/sim/multiplay/generic/bool[20]</path>
        <path>/sim/multiplay/generic/bool[21]</path>
        <path>/sim/multiplay/generic/bool[22]</path>
        <path>/sim/multiplay/generic/bool[23]</path>
        <path>/sim/multiplay/generic/bool[24]</path>
        <path>/sim/multiplay/generic/bool[25]</path>
        <path>/sim/multiplay/generic/bool[26]</path>
        <path>/sim/multiplay/generic/bool[27]</path>
        <path>/sim/multiplay/generic/bool[28]</path>
        <path>/sim/multiplay/generic/bool[29]</path>
        <path>/sim/multiplay/generic/bool[30]</path>
    </aircraft-data>

		<!-- HUD -->
		<hud>
			<path n="1">Aircraft/Akinci/Systems/HUD.xml</path>
			<visibility n="1">true</visibility>
   
			<palette>
				<color n="0">
					<alpha type="float">0.85</alpha>
					<antialiased type="bool">true</antialiased>
					<brightness type="float">0.85</brightness>
					<transparent type="bool">true</transparent>
					<red type="float">0.38</red>
					<green type="float">1.0</green>
					<blue type="float">0.22</blue>
				</color>
				<color n="1">
					<alpha type="float">0.85</alpha>
					<antialiased type="bool">true</antialiased>
					<brightness type="float">0.85</brightness>
					<transparent type="bool">true</transparent>
					<red type="float">1.0</red>
					<green type="float">0.2</green>
					<blue type="float">0.0</blue>
				</color>
			</palette>
		</hud>

  <ai>

  <submodels>
    <SOM-J-1-number type="int">1</SOM-J-1-number>
    <SOM-J-number type="int">2</SOM-J-number>
    <GBU-12-1-number type="int">1</GBU-12-1-number>
    <GBU-12-number type="int">2</GBU-12-number>
    <GBU-54-number type="int">4</GBU-54-number>
  </submodels>

  </ai>

  </sim>

  <input             include="Akinci-keyboard.xml"/>

  <controls          include="controls.xml"/>

  <consumables       include="consumables.xml"/>

  <engines           include="engines.xml"/>

  <systems           include="systems.xml"/>

  <autopilot         include="autopilot.xml"/>

  <instrumentation   include="instrumentation.xml">
    <gsdi>
      <serviceable   type="bool">true</serviceable>
      <enabled       type="bool">true</enabled>
    </gsdi>
  </instrumentation>

  <nasal>
    <akinci>
      <file>Aircraft/Akinci/Nasal/hdr.nas</file>
      <file>Aircraft/Akinci/Nasal/liveries.nas</file>
      <file>Aircraft/Akinci/Nasal/light.nas</file>
      <file>Aircraft/Akinci/Nasal/convert.nas</file>
      <file>Aircraft/Akinci/Nasal/Electrical.nas</file>
      <file>Aircraft/Akinci/Nasal/map.nas</file>
      <file>Aircraft/Akinci/Nasal/dialog.nas</file>
      <file>Aircraft/Akinci/Nasal/HUD.nas</file>
    </akinci>
    <doors>
      <file>Aircraft/Akinci/Nasal/doors.nas</file>
    </doors>
    <turrets>
      <file>Aircraft/Akinci/Nasal/turrets.nas</file>
      <script>
      </script>
    </turrets>
    <engines>
      <file>Aircraft/Akinci/Nasal/generic-yasim-engine.nas</file>
      <file>Aircraft/Akinci/Nasal/engines-yasim.nas</file>
    </engines>

    aircraft.data.add(

      "instrumentation/nav[0]/power-btn",
      "instrumentation/nav[0]/audio-btn",
      "instrumentation/nav[0]/frequencies/selected-mhz",
      "instrumentation/nav[0]/frequencies/standby-mhz",
      "instrumentation/nav[0]/to-flag",
      "instrumentation/nav[0]/from-flag",
      "instrumentation/nav[0]/radials/selected-deg",
      "instrumentation/nav[0]/gs-needle-deflection",
      "instrumentation/nav[0]/heading-needle-deflection",
      "instrumentation/nav[0]/in-range",
      "instrumentation/comm[0]/volume",
      "instrumentation/comm[0]/frequencies/selected-mhz",
      "instrumentation/comm[0]/frequencies/standby-mhz",
      "instrumentation/comm[0]/test-btn",

      "instrumentation/nav[1]/power-btn",
      "instrumentation/nav[1]/audio-btn",
      "instrumentation/nav[1]/frequencies/selected-mhz",
      "instrumentation/nav[1]/frequencies/standby-mhz",
      "instrumentation/nav[1]/to-flag",
      "instrumentation/nav[1]/from-flag",
      "instrumentation/nav[1]/radials/selected-deg",
      "instrumentation/nav[1]/gs-needle-deflection",
      "instrumentation/nav[1]/heading-needle-deflection",
      "instrumentation/nav[1]/in-range",
      "instrumentation/comm[1]/volume",
      "instrumentation/comm[1]/frequencies/selected-mhz",
      "instrumentation/comm[1]/frequencies/standby-mhz",
      "instrumentation/comm[1]/test-btn",

    );

  </nasal>

</PropertyList>
