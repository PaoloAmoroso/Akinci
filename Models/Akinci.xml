<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>Akinci.ac</path>

  <!-- MP sound call -->
  <sound>
    <path>Aircraft/Akinci/Sounds/mp-sound.xml</path>
  </sound>

  <nasal>
    <load>
      var livery_update = aircraft.livery_update.new("Aircraft/Akinci/Models/Liveries", 10);
    </load>
    <unload>
      livery_update.stop();
    </unload>
  </nasal>

  <animation>
    <!-- Objets opaques -->

    <object-name>Fuselage</object-name>
    <object-name>GearNDoorL</object-name>
    <object-name>GearNDoorR</object-name>
    <object-name>Interiors</object-name>
    <object-name>Pitot</object-name>
    <object-name>Antennas</object-name>
    <object-name>C-Band</object-name>
    <object-name>Cameras</object-name>
    <object-name>FLIRBase</object-name>
    <object-name>FLIRHead</object-name>
    <object-name>REDET</object-name>
    <object-name>HEDET</object-name>
    <object-name>Pylon_C1</object-name>
    <object-name>Pylons_W1</object-name>
    <object-name>Pylons_W2-1</object-name>
    <object-name>Pylons_W2-3</object-name>
    <object-name>Pylons_W2-3</object-name>

    <object-name>Wing_1</object-name>
    <object-name>Wing_2</object-name>
    <object-name>AileronL</object-name>
    <object-name>AileronR</object-name>
    <object-name>FlapL</object-name>
    <object-name>FlapR</object-name>
    <object-name>StabH</object-name>
    <object-name>ElevatorL</object-name>
    <object-name>ElevatorR</object-name>
    <object-name>StabV</object-name>
    <object-name>Rudder</object-name>
    <object-name>Fairings</object-name>

    <object-name>Nacelle</object-name>
    <object-name>OgivaL</object-name>
    <object-name>OgivaR</object-name>
    <object-name>PropL</object-name>
    <object-name>PropR</object-name>
    <object-name>Exaust</object-name>

    <object-name>MainGearL</object-name>
    <object-name>MainGearR</object-name>
    <object-name>WheelL</object-name>
    <object-name>WheelR</object-name>
    <object-name>MainGearL</object-name>
    <object-name>Strut1N</object-name>
    <object-name>Strut2N</object-name>
    <object-name>Scissor1N</object-name>
    <object-name>Scissor2N</object-name>
    <object-name>JawN</object-name>
    <object-name>WheelN</object-name>

    <!-- Objets transparents -->
    <object-name>FLIRGlass</object-name>
    
    <!-- HDR mode -->
    <object-name>FLIRGlassHDR</object-name>

  </animation>

  <animation>
    <type>material</type>

    <object-name>Fuselage</object-name>
    <object-name>GearNDoorL</object-name>
    <object-name>GearNDoorR</object-name>
    <object-name>Interiors</object-name>
    <object-name>Pitot</object-name>
    <object-name>Antennas</object-name>
    <object-name>C-Band</object-name>
    <object-name>Cameras</object-name>
    <object-name>FLIRBase</object-name>
    <object-name>FLIRHead</object-name>
    <object-name>REDET</object-name>
    <object-name>HEDET</object-name>
    <object-name>Pylon_C1</object-name>
    <object-name>Pylons_W1</object-name>
    <object-name>Pylons_W2-1</object-name>
    <object-name>Pylons_W2-3</object-name>
    <object-name>Pylons_W2-3</object-name>

    <object-name>Wing_1</object-name>
    <object-name>Wing_2</object-name>
    <object-name>AileronL</object-name>
    <object-name>AileronR</object-name>
    <object-name>FlapL</object-name>
    <object-name>FlapR</object-name>
    <object-name>StabH</object-name>
    <object-name>ElevatorL</object-name>
    <object-name>ElevatorR</object-name>
    <object-name>StabV</object-name>
    <object-name>Rudder</object-name>
    <object-name>Fairings</object-name>

    <object-name>Nacelle</object-name>
    <object-name>OgivaL</object-name>
    <object-name>OgivaR</object-name>
    <object-name>PropL</object-name>
    <object-name>PropR</object-name>
    <object-name>Exaust</object-name>

    <object-name>MainGearL</object-name>
    <object-name>MainGearR</object-name>
    <object-name>WheelL</object-name>
    <object-name>WheelR</object-name>
    <object-name>MainGearL</object-name>
    <object-name>Strut1N</object-name>
    <object-name>Strut2N</object-name>
    <object-name>Scissor1N</object-name>
    <object-name>Scissor2N</object-name>
    <object-name>JawN</object-name>
    <object-name>WheelN</object-name>

    <object-name>FLIRGlass</object-name>
    <object-name>FLIRGlassHDR</object-name>

    <property-base>sim/model/livery</property-base>
    <texture-prop>texture</texture-prop>
    <texture>texture.png</texture>
    <specular>
      <red-prop>specular/red</red-prop>
      <green-prop>specular/green</green-prop>
      <blue-prop>specular/blue</blue-prop>
    </specular>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>Effects/Glass/glassrain</inherits-from>
    <object-name>FLIRGlass</object-name>
  </effect>

  <effect>
    <inherits-from>Effects/Glass/glass</inherits-from>
    <object-name>FLIRGlassHDR</object-name>
  </effect>

  <!-- HDR Glass Selection -->
  <animation>
    <type>select</type>
    <condition>
      <!-- <property>sim/rendering/hdr/hdr-enabled</property> -->
      <property>sim/multiplay/generic/bool[2]</property>
    </condition>
    <object-name>FLIRGlassHDR</object-name>
  </animation>

  <animation>
    <type>select</type>
    <condition>
      <!-- <not><property>sim/rendering/hdr/hdr-enabled</property></not> -->
      <not><property>sim/multiplay/generic/bool[2]</property></not>
    </condition>
    <object-name>FLIRGlass</object-name>
  </animation>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>propdiscL</object-name>
    <object-name>propblurL</object-name>
    <object-name>propdiscR</object-name>
    <object-name>propblurR</object-name>
  </effect>

  <model>
    <path>Effects/cranking/all-crankings.xml</path>
  </model>

  <model>
    <path>Effects/trail/all-trails.xml</path>
  </model>

  <model>
    <path>Effects/tiptrail/all-tiptrails.xml</path>
  </model>

  <model>
    <path>Effects/ground/all-ground.xml</path>
  </model>
<!--
  <model>
    <path>light/all-lights.xml</path>
  </model>
-->
  <!-- ENGINES -->

  <!-- Left Engine -->

  <!-- RPM Prop Effects -->
  <animation>
    <type>select</type>
    <object-name>propdiscL</object-name>
    <condition>
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value>900</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblurL</object-name>
    <condition>
    <and>
      <greater-than>
        <property>engines/engine[0]/rpm</property>
        <value>300.000</value>
      </greater-than>
      <less-than>
        <property>engines/engine[0]/rpm</property>
        <value>900.001</value>
      </less-than>
    </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>PropL</object-name>
    <condition>
      <less-than>
        <property>engines/engine[0]/rpm</property>
        <value>900</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>PropL</object-name>
    <object-name>OgivaL</object-name>
    <object-name>propdiscL</object-name>
    <object-name>propblurL</object-name>
    <condition>
      <!-- <not><property>controls/engines/engine[0]/cutoff</property></not> -->
      <not><property>sim/multiplay/generic/bool[6]</property></not>
    </condition>
    <property>engines/engine[0]/n1</property>
    <factor> 5 </factor>
    <center>
      <x-m> -3.565600 </x-m>
      <y-m> -2.319800 </y-m>
      <z-m>  0.058775 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- Right Engine -->

  <!-- RPM Prop Effects -->
  <animation>
    <type>select</type>
    <object-name>propdiscR</object-name>
    <condition>
      <greater-than>
        <property>engines/engine[1]/rpm</property>
        <value>900</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>propblurR</object-name>
    <condition>
    <and>
      <greater-than>
        <property>engines/engine[1]/rpm</property>
        <value>300.000</value>
      </greater-than>
      <less-than>
        <property>engines/engine[1]/rpm</property>
        <value>900.001</value>
      </less-than>
    </and>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>PropR</object-name>
    <condition>
      <less-than>
        <property>engines/engine[1]/rpm</property>
        <value>900</value>
      </less-than>
    </condition>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>PropR</object-name>
    <object-name>OgivaR</object-name>
    <object-name>propdiscR</object-name>
    <object-name>propblurR</object-name>
    <condition>
      <!-- <not><property>controls/engines/engine[1]/cutoff</property></not> -->
      <not><property>sim/multiplay/generic/bool[7]</property></not>
    </condition>
    <property>engines/engine[1]/n1</property>
    <factor> 5 </factor>
    <center>
      <x-m> -3.565600 </x-m>
      <y-m>  2.319800 </y-m>
      <z-m>  0.058775 </z-m>
    </center>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- FLIGHT CONTROL SURFACES -->

  <!-- Ailerons -->
  <animation>
    <type>rotate</type>
    <object-name>AileronL</object-name>
    <property>surface-positions/left-aileron-pos-norm</property>
    <factor> 16 </factor>
    <axis>
      <x1-m> -0.65298 </x1-m>
      <y1-m> -9.06140 </y1-m>
      <z1-m>  0.17788 </z1-m>
      <x2-m> -0.87544 </x2-m>
      <y2-m> -6.34000 </y2-m>
      <z2-m>  0.23162 </z2-m>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>AileronR</object-name>
    <property>surface-positions/right-aileron-pos-norm</property>
    <factor> 16 </factor>
    <axis>
      <x1-m> -0.87544 </x1-m>
      <y1-m>  6.34000 </y1-m>
      <z1-m>  0.23162 </z1-m>
      <x2-m> -0.65298 </x2-m>
      <y2-m>  9.06140 </y2-m>
      <z2-m>  0.17788 </z2-m>
    </axis>
  </animation>

  <!-- Elevators -->
  <animation>
    <type>rotate</type>
    <object-name>ElevatorL</object-name>
    <!-- <property>controls/flight/elevator</property> -->
    <property>surface-positions/elevator-pos-norm</property>
    <factor> -18 </factor>
    <axis>
      <x1-m>  5.35270 </x1-m>
      <y1-m> -0.33826 </y1-m>
      <z1-m>  0.05473 </z1-m>
      <x2-m>  6.01620 </x2-m>
      <y2-m> -2.63480 </y2-m>
      <z2-m> -0.22663 </z2-m>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>ElevatorR</object-name>
    <!-- <property>controls/flight/elevator</property> -->
    <property>surface-positions/elevator-pos-norm</property>
    <factor> -18 </factor>
    <axis>
      <x1-m>  6.01620 </x1-m>
      <y1-m>  2.63480 </y1-m>
      <z1-m> -0.22663 </z1-m>
      <x2-m>  5.35270 </x2-m>
      <y2-m>  0.33826 </y2-m>
      <z2-m>  0.05473 </z2-m>
    </axis>
  </animation>

  <!-- Rudder -->
  <animation>
    <type>rotate</type>
    <object-name>Rudder</object-name>
    <!-- <property>controls/flight/rudder</property> -->
    <property>surface-positions/rudder-pos-norm</property>
    <factor> 18 </factor>
    <axis>
      <x1-m> 5.9108 </x1-m>
      <y1-m> 0.0000 </y1-m>
      <z1-m> 2.5332 </z1-m>
      <x2-m> 5.3189 </x2-m>
      <y2-m> 0.0000 </y2-m>
      <z2-m> 0.2941 </z2-m>
    </axis>
  </animation>

  <!-- Flaps - INOP -->
  <animation>
    <type>translate</type>
    <object-name>FlapL</object-name>
    <object-name>FlapR</object-name>
    <property>surface-positions/flap-pos-norm</property>
    <factor> 0.05 </factor>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>FlapL</object-name>
    <property>surface-positions/flap-pos-norm</property>
    <factor> 35 </factor>
    <axis>
      <x1-m> -0.87544 </x1-m>
      <y1-m> -6.34000 </y1-m>
      <z1-m>  0.23162 </z1-m>
      <x2-m> -1.15920 </x2-m>
      <y2-m> -2.86830 </y2-m>
      <z2-m>  0.30017 </z2-m>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>FlapR</object-name>
    <property>surface-positions/flap-pos-norm</property>
    <factor> 35 </factor>
    <axis>
      <x1-m> -1.15920 </x1-m>
      <y1-m>  2.86830 </y1-m>
      <z1-m>  0.30017 </z1-m>
      <x2-m> -0.87544 </x2-m>
      <y2-m>  6.34000 </y2-m>
      <z2-m>  0.23162 </z2-m>
    </axis>
  </animation>

  <!-- LANDING GEAR -->

  <!-- Nose Gear Retraction -->
  <animation>
    <type>rotate</type>
    <object-name>Strut1N</object-name>
    <object-name>Strut2N</object-name>
    <object-name>Scissor1N</object-name>
    <object-name>Scissor2N</object-name>
    <object-name>JawN</object-name>
    <object-name>WheelN</object-name>
    <property>gear/gear[0]/position-norm</property>
    <interpolation>
      <entry><ind> 0 </ind><dep> 95 </dep></entry>
      <entry><ind> 1 </ind><dep>  0 </dep></entry>
    </interpolation>
    <center>
      <x-m> -3.37190 </x-m>
      <y-m>  0.00000 </y-m>
      <z-m> -0.44171 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Left Main Gear Retraction -->
  <animation>
    <type>translate</type>
    <object-name>MainGearL</object-name>
    <object-name>WheelL</object-name>
    <property>gear/gear[1]/position-norm</property>
    <interpolation>
      <entry><ind> 0 </ind><dep> -0.4 </dep></entry>
      <entry><ind> 1 </ind><dep>  0.0 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m> -0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>MainGearL</object-name>
    <object-name>WheelL</object-name>
    <property>gear/gear[1]/position-norm</property>
    <factor> 96 </factor>
    <offset-deg> -96 </offset-deg>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m> -0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>MainGearL</object-name>
    <object-name>WheelL</object-name>
    <property>gear/gear[1]/position-norm</property>
    <factor> -44 </factor>
    <offset-deg> 44 </offset-deg>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m> -0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Right Main Gear Retraction -->
  <animation>
    <type>translate</type>
    <object-name>MainGearR</object-name>
    <object-name>WheelR</object-name>
    <property>gear/gear[2]/position-norm</property>
    <interpolation>
      <entry><ind> 0 </ind><dep> -0.4 </dep></entry>
      <entry><ind> 1 </ind><dep>  0.0 </dep></entry>
    </interpolation>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m>  0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>MainGearR</object-name>
    <object-name>WheelR</object-name>
    <property>gear/gear[2]/position-norm</property>
    <factor> 96 </factor>
    <offset-deg> -96 </offset-deg>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m>  0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>MainGearR</object-name>
    <object-name>WheelR</object-name>
    <property>gear/gear[2]/position-norm</property>
    <factor>  44 </factor>
    <offset-deg> -44 </offset-deg>
    <center>
      <x-m> -0.43682 </x-m>
      <y-m>  0.44730 </y-m>
      <z-m> -0.37193 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- NOSE GEAR RUDDER -->

  <animation>
    <type>rotate</type>
    <object-name>JawN</object-name>
    <object-name>WheelN</object-name>
    <!-- <property>gear/gear[0]/caster-angle-deg</property> -->
    <property>sim/multiplay/generic/float[15]</property>
    <factor> -1 </factor>
    <center>
      <x-m> -3.8668 </x-m>
      <y-m>  0.0000 </y-m>
      <z-m> -1.4391 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <!-- WHEELS ROTATION -->
  <animation>
    <type>spin</type>
    <object-name>WheelN</object-name>
    <!-- <property>gear/gear[0]/rollspeed-ms</property> -->
    <property>sim/multiplay/generic/float[12]</property>
    <factor> 30 </factor>
    <center>
      <x-m> -3.7628 </x-m>
      <y-m>  0.0000 </y-m>
      <z-m> -1.6272 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>WheelL</object-name>
    <!-- <property>gear/gear[1]/rollspeed-ms</property> -->
    <property>sim/multiplay/generic/float[13]</property>
    <factor> 30 </factor>
    <center>
      <x-m> -0.7282 </x-m>
      <y-m> -1.4229 </y-m>
      <z-m> -1.5766 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <animation>
    <type>spin</type>
    <object-name>WheelR</object-name>
    <!-- <property>gear/gear[2]/rollspeed-ms</property> -->
    <property>sim/multiplay/generic/float[14]</property>
    <factor> 30 </factor>
    <center>
      <x-m> -0.7282 </x-m>
      <y-m>  1.4229 </y-m>
      <z-m> -1.5766 </z-m>
    </center>
    <axis>
      <x>  0 </x>
      <y> -1 </y>
      <z>  0 </z>
    </axis>
  </animation>

  <!-- Compression - INOP -->

  <!-- DOORS -->

  <!-- Landing Gear Door -->
  <animation>
    <type>rotate</type>
    <object-name>GearNDoorL</object-name>
    <property>gear/gear[0]/position-norm</property>
    <interpolation>
      <entry><ind> 0.0 </ind><dep>   0 </dep></entry>
      <entry><ind> 0.1 </ind><dep> -85 </dep></entry>
      <entry><ind> 1.0 </ind><dep> -85 </dep></entry>
    </interpolation>
    <axis>
